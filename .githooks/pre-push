#!/bin/sh
set -eu
expected='yunzenn|209125778+Yunzenn@users.noreply.github.com|yunzenn|209125778+Yunzenn@users.noreply.github.com'
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
    metadata=$(git log --format='%an|%ae|%cn|%ce' "$local_oid") || exit 1
    if ! printf '%s\n' "$metadata" | while IFS= read -r identity; do
        [ "$identity" = "$expected" ] || exit 1
    done; then
        echo 'Push blocked: reachable commit metadata does not use yunzenn privacy identity.' >&2
        exit 1
    fi
    if [ "$(git cat-file -t "$local_oid")" = tag ]; then
        tag_identity=$(git for-each-ref --format='%(taggername)|%(taggeremail)' "$local_ref")
        if [ "$tag_identity" != 'yunzenn|<209125778+Yunzenn@users.noreply.github.com>' ]; then
            echo 'Push blocked: tag metadata does not use yunzenn privacy identity.' >&2
            exit 1
        fi
    fi
done
