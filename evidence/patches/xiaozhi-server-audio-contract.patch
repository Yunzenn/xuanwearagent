From: xuanwearagent Phase 0C audit
Subject: [PATCH] separate client uplink from server playback audio contract
Base: xinnan-tech/xiaozhi-esp32-server@788f5301fdd60cc3a8ef74025bfeece9b82b94ce

diff --git a/main/xiaozhi-server/core/handle/helloHandle.py b/main/xiaozhi-server/core/handle/helloHandle.py
--- a/main/xiaozhi-server/core/handle/helloHandle.py
+++ b/main/xiaozhi-server/core/handle/helloHandle.py
@@ -17,4 +17,11 @@ from core.providers.tools.device_mcp import MCPClient, send_mcp_initialize_messa
 
 TAG = __name__
 
+SUPPORTED_CLIENT_AUDIO_PARAMS = {
+    "format": "opus",
+    "sample_rate": 16000,
+    "channels": 1,
+    "frame_duration": 60,
+}
+
 WAKEUP_CONFIG = {
@@ -42,9 +49,29 @@ _wakeup_response_lock = asyncio.Lock()
 async def handleHelloMessage(conn: "ConnectionHandler", msg_json):
     """处理hello消息"""
     audio_params = msg_json.get("audio_params")
-    if audio_params:
-        format = audio_params.get("format")
-        conn.logger.bind(tag=TAG).debug(f"客户端音频格式: {format}")
-        conn.audio_format = format
-        conn.welcome_msg["audio_params"] = audio_params
+    if isinstance(audio_params, dict):
+        client_audio_params = {
+            "format": audio_params.get("format"),
+            "sample_rate": audio_params.get("sample_rate"),
+            "channels": audio_params.get("channels"),
+            "frame_duration": audio_params.get("frame_duration"),
+        }
+        if client_audio_params == SUPPORTED_CLIENT_AUDIO_PARAMS:
+            conn.client_audio_format = client_audio_params["format"]
+            conn.client_sample_rate = client_audio_params["sample_rate"]
+            conn.client_channels = client_audio_params["channels"]
+            conn.client_frame_duration = client_audio_params["frame_duration"]
+            # Backward-compatible alias used by existing uplink handling.
+            conn.audio_format = conn.client_audio_format
+            conn.logger.bind(tag=TAG).debug(
+                f"客户端上行音频格式: {conn.client_audio_format}, "
+                f"{conn.client_sample_rate}Hz/{conn.client_channels}ch/"
+                f"{conn.client_frame_duration}ms"
+            )
+        else:
+            conn.logger.bind(tag=TAG).debug(
+                f"忽略不支持的客户端上行音频参数: {audio_params}"
+            )
+    elif audio_params is not None:
+        conn.logger.bind(tag=TAG).debug("忽略格式错误的客户端上行音频参数")
     features = msg_json.get("features")

diff --git a/main/xiaozhi-server/core/connection.py b/main/xiaozhi-server/core/connection.py
--- a/main/xiaozhi-server/core/connection.py
+++ b/main/xiaozhi-server/core/connection.py
@@ -109,8 +109,14 @@ class ConnectionHandler:
         self.welcome_msg = None
         self.max_output_size = 0
         self.chat_history_conf = 0
+        # Client hello describes uplink/capture audio only.
         self.audio_format = "opus"
+        self.client_audio_format = "opus"
+        self.client_sample_rate = 16000
+        self.client_channels = 1
+        self.client_frame_duration = 60
+        # This field is downlink/TTS and is refreshed from the server welcome config.
         self.sample_rate = 24000  # 默认采样率，从客户端 hello 消息中动态更新
 
         # 客户端状态相关
         self.client_abort = False
@@ -544,5 +550,8 @@ class ConnectionHandler:
                 return None
 
             self._init_connection_state(self)
-            pcm_frame = self._connection_opus_decoder.decode(opus_packet, 960)
+            frame_size = int(
+                self.client_sample_rate * self.client_frame_duration / 1000
+            )
+            pcm_frame = self._connection_opus_decoder.decode(opus_packet, frame_size)
             return pcm_frame
@@ -555,4 +564,6 @@ class ConnectionHandler:
         if not hasattr(conn, "_connection_opus_decoder"):
-            conn._connection_opus_decoder = opuslib_next.Decoder(16000, 1)
+            conn._connection_opus_decoder = opuslib_next.Decoder(
+                conn.client_sample_rate, conn.client_channels
+            )
 
     async def handle_restart(self, message):

diff --git a/main/xiaozhi-server/core/providers/tts/base.py b/main/xiaozhi-server/core/providers/tts/base.py
--- a/main/xiaozhi-server/core/providers/tts/base.py
+++ b/main/xiaozhi-server/core/providers/tts/base.py
@@ -312,5 +312,11 @@ class TTSProviderBase(ABC):
             self.opus_encoder = opus_encoder_utils.OpusEncoderUtils(
                 sample_rate=conn.sample_rate, channels=1, frame_size_ms=60
             )
+        elif self.opus_encoder.sample_rate != conn.sample_rate:
+            raise ValueError(
+                "TTS Opus sample rate does not match Server Hello playback "
+                f"sample rate: encoder={self.opus_encoder.sample_rate}, "
+                f"server_hello={conn.sample_rate}"
+            )
 
         # tts 消化线程
